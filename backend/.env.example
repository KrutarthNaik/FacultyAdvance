SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGIN=http://localhost:5173
# Use FRONTEND_ORIGINS as a comma-separated list when multiple frontends are allowed.
# FRONTEND_ORIGINS=https://faculty.example.edu,https://faculty-preview.vercel.app
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0
# Production Vercel requires TLS Redis, for example rediss://user:password@host:6379.
REDIS_URL=
# Optional existing SQLite path used only to compare migration row counts.
SQLITE_MIGRATION_SOURCE=
# Local email is written to the development console by default.
# For Gmail, enable 2-Step Verification, then create a Google Account App Password
# and set EMAIL_HOST_PASSWORD. Never commit the App Password.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
EMAIL_ALERTS_ENABLED=True
PUBLIC_REGISTRATION_ENABLED=True
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173/verify-email
# Google Workspace SSO is opt-in. Register the backend callback URI in Google Cloud.
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
GOOGLE_SSO_WORKSPACE_DOMAIN=
GOOGLE_SSO_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback/
GOOGLE_SSO_FRONTEND_CALLBACK=http://localhost:5173/sso/callback
ACCOUNT_TOKEN_MAX_AGE=86400
AUTH_RATE=5/minute
REGISTRATION_RATE=3/hour
EMAIL_ACTION_RATE=3/hour
API_ANON_RATE=60/hour
API_USER_RATE=1000/hour
NOTIFICATION_RETENTION_DAYS=0
CSRF_TRUSTED_ORIGINS=http://localhost:5173
TRUST_PROXY_SSL_HEADER=False
EVIDENCE_UPLOAD_MAX_BYTES=10485760
# For a hosted deployment, set DEBUG=False, https:// origins, a real SECRET_KEY,
# DATABASE_URL with sslmode=verify-full, and a production email backend.
# Enable only after configuring a private bucket with public access blocked.
USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
